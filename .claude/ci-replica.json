{
  "version": 1,
  "logDir": ".ci-replica",
  "env": {
    "CI": "true"
  },
  "unset": [
    "BASH_ENV"
  ],
  "jobs": [
    {
      "name": "lint",
      "$mirrors": "self-check.yml `lint`",
      "budgetSeconds": 120,
      "commands": [
        "actionlint",
        "bash scripts/check-composite-shape.sh",
        "bash scripts/check-doc-pins.sh",
        "bash scripts/check-dependency-inventory-fixtures.sh",
        "bash scripts/next-release-tag.test.sh",
        "bash scripts/run-composite.test.sh",
        "bash scripts/shared-actions.test.sh"
      ]
    },
    {
      "name": "file-failure-issue-fixture",
      "$mirrors": "self-check.yml `file-failure-issue-fixture`",
      "budgetSeconds": 60,
      "commands": [
        "bash actions/file-failure-issue/fixture-test.sh \"the automated check failed\""
      ]
    },
    {
      "name": "check-action-pins-fixture",
      "$mirrors": "self-check.yml `check-action-pins-fixture`, through the real action.yml",
      "budgetSeconds": 60,
      "commands": [
        "scripts/run-composite.py actions/check-action-pins --input workflow-dir=.github/fixtures/check-action-pins/violations --expect fail",
        "scripts/run-composite.py actions/check-action-pins --input workflow-dir=.github/fixtures/check-action-pins/clean",
        "scripts/run-composite.py actions/check-action-pins --input workflow-dir=.github/fixtures/check-action-pins/nested-only --expect fail",
        "scripts/run-composite.py actions/check-action-pins --input workflow-dir=.github/workflows",
        "scripts/run-composite.py actions/check-action-pins --input workflow-dir=actions"
      ]
    },
    {
      "name": "check-migration-locks-fixture",
      "$mirrors": "self-check.yml `check-migration-locks-fixture`, through the real action.yml",
      "budgetSeconds": 60,
      "commands": [
        "scripts/run-composite.py actions/check-migration-locks --input since=20260101000000 --input migrations-dir=.github/fixtures/check-migration-locks/violations --expect fail",
        "scripts/run-composite.py actions/check-migration-locks --input since=20260101000000 --input migrations-dir=.github/fixtures/check-migration-locks/clean"
      ]
    },
    {
      "name": "check-dependency-licenses-fixture",
      "$mirrors": "self-check.yml `check-dependency-licenses-fixture`, through the real action.yml",
      "budgetSeconds": 60,
      "commands": [
        "scripts/run-composite.py actions/check-dependency-licenses --input lockfile=.github/fixtures/check-dependency-licenses/violations/package-lock.json --expect fail",
        "scripts/run-composite.py actions/check-dependency-licenses --input lockfile=.github/fixtures/check-dependency-licenses/clean/package-lock.json"
      ]
    },
    {
      "name": "check-required-checks-fixture",
      "$mirrors": "self-check.yml `check-required-checks-fixture`, through the real action.yml",
      "budgetSeconds": 60,
      "commands": [
        "scripts/run-composite.py actions/check-required-checks --input ci-workflow=.github/fixtures/check-required-checks/violations/ci.yml --input manifest=.github/fixtures/check-required-checks/violations/required-checks.json --expect fail",
        "scripts/run-composite.py actions/check-required-checks --input ci-workflow=.github/fixtures/check-required-checks/clean/ci.yml --input manifest=.github/fixtures/check-required-checks/clean/required-checks.json"
      ]
    },
    {
      "name": "cwv-judge-fixtures",
      "$mirrors": "self-check.yml `cwv-judge-fixtures`, through the real action.yml",
      "budgetSeconds": 60,
      "commands": [
        "bash scripts/cwv-judge.test.sh",
        "scripts/run-composite.py actions/cwv-judge --input measurements-file=.github/fixtures/cwv-judge/regression/tonight.json --input history-dir=.github/fixtures/cwv-judge/regression --expect fail",
        "scripts/run-composite.py actions/cwv-judge --input measurements-file=.github/fixtures/cwv-judge/single-night-spike/tonight.json --input history-dir=.github/fixtures/cwv-judge/single-night-spike --expect-output verdict=clean",
        "scripts/run-composite.py actions/cwv-judge --input measurements-file=.github/fixtures/cwv-judge/under-floor/tonight.json --input history-dir=.github/fixtures/cwv-judge/under-floor --expect-output verdict=clean",
        "scripts/run-composite.py actions/cwv-judge --input measurements-file=.github/fixtures/cwv-judge/cold-start/tonight.json --input history-dir=.github/fixtures/cwv-judge/cold-start --expect-output verdict=insufficient-history"
      ]
    },
    {
      "name": "pr-body-lint-fixtures",
      "$mirrors": "self-check.yml `pr-body-lint-fixtures`, through the real action.yml",
      "budgetSeconds": 60,
      "commands": [
        "scripts/run-composite.py actions/pr-body-lint --input 'body=Does not close #4885 \u2014 the recapture itself is still owed.' --expect fail",
        "scripts/run-composite.py actions/pr-body-lint --input 'body=Closes #4879, #4885' --expect fail",
        "scripts/run-composite.py actions/pr-body-lint --input 'body=Closes #12'",
        "scripts/run-composite.py actions/pr-body-lint --input 'body=Closes #12, Closes #34'"
      ]
    },
    {
      "name": "deploy-target-fixtures",
      "$mirrors": "self-check.yml `deploy-target-fixtures`, through the real action.yml",
      "budgetSeconds": 60,
      "commands": [
        "node actions/deploy-target/deploy-target.fixtures.mjs",
        "scripts/run-composite.py actions/deploy-target --input git-ref=dev --input always-build-refs=dev --input always-build-ref-prefixes=release/ --input 'paths=apps/web/' --input changed-paths=apps/web/src/App.tsx --expect-output build=true",
        "scripts/run-composite.py actions/deploy-target --input git-ref=feature/x --input always-build-refs=dev --input always-build-ref-prefixes=release/ --expect-output build=false",
        "scripts/run-composite.py actions/deploy-target --input git-ref=feature/x --input always-build-refs=dev --input always-build-ref-prefixes=release/ --input 'paths=apps/web/' --input $'changed-paths=apps/server/index.ts\\nprisma/schema.prisma' --expect-output build=false"
      ]
    },
    {
      "name": "ci-success-dogfood",
      "$mirrors": "self-check.yml `ci-success-dogfood`, through the real action.yml",
      "budgetSeconds": 60,
      "commands": [
        "scripts/run-composite.py actions/ci-success --input 'needs={\"a\":{\"result\":\"success\"},\"b\":{\"result\":\"success\"}}'",
        "scripts/run-composite.py actions/ci-success --input 'needs={\"a\":{\"result\":\"success\"},\"b\":{\"result\":\"skipped\"}}' --expect fail",
        "scripts/run-composite.py actions/ci-success --input 'needs={\"a\":{\"result\":\"failure\"}}' --expect fail",
        "scripts/run-composite.py actions/ci-success --input 'needs={\"a\":{\"result\":\"cancelled\"}}' --expect fail",
        "scripts/run-composite.py actions/ci-success --input 'needs={}' --expect fail",
        "scripts/run-composite.py actions/ci-success --input 'needs={\"a\":{\"result\":\"success\"},\"b\":{\"result\":\"skipped\"}}' --input allow-skipped=b",
        "scripts/run-composite.py actions/ci-success --input 'needs={\"a\":{\"result\":\"skipped\"},\"b\":{\"result\":\"skipped\"}}' --input 'allow-skipped=a, b'",
        "scripts/run-composite.py actions/ci-success --input 'needs={\"a\":{\"result\":\"skipped\"},\"b\":{\"result\":\"skipped\"}}' --input allow-skipped=a --expect fail"
      ]
    },
    {
      "name": "post-deploy-probe-fixtures",
      "local": false,
      "localReason": "probe-fixture-good/bad call the reusable workflow post-deploy-probe.yml, which only a runner executes; owed as `self-check-on-actions` in .claude/owed-verdicts.json",
      "commands": []
    },
    {
      "name": "v1-current",
      "local": false,
      "localReason": "runs on push to main, never on a PR; v1 is expected to trail main until release.yml runs on Actions (owed as `v1-release`)",
      "commands": []
    }
  ]
}
